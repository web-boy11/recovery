# ═══════════════════════════════════════════════════════════════════════════════
# Environment Variables — globalfraudrecovery.site
# ═══════════════════════════════════════════════════════════════════════════════
#
# For LOCAL DEVELOPMENT:  Copy this file to .env and fill in values.
# For CLOUDFLARE PAGES:   Set these in Dashboard → Pages → Settings → Environment Variables.
# For CLOUDFLARE WORKER:  Set these in Dashboard → Workers → Settings → Variables.
#
# ── SMTP Settings (for local dev server / Netlify Functions) ─────────────────
SMTP_HOST=mail.globalfraudrecovery.site
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=collinsmcdonald@globalfraudrecovery.site
SMTP_PASS=YourDomainPasswordHere

# ── Official Sender Identity ────────────────────────────────────────────────
FROM_NAME=Special Agent Collins McDonald — FFRD Task Force
FROM_EMAIL=collinsmcdonald@globalfraudrecovery.site

# ── Administrative Alerts ───────────────────────────────────────────────────
ADMIN_ALERT_EMAIL=seanjordanw@gmail.com

# ── Transactional Email API (Cloudflare Workers / Pages) ────────────────────
# Set ONE of these. Resend is recommended for Cloudflare deployments.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx

# ── Cloudflare Pages Build Configuration ────────────────────────────────────
# Set NODE_VERSION in Cloudflare Pages Dashboard → Settings → Environment Variables
# NODE_VERSION=20.18.0
